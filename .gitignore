# Dependencies
node_modules/

# Build output (rebuilt on install via the `prepare` script)
lib/
dist/

# Test / tooling artifacts
coverage/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Accidental nested clone / scratch directories (never part of this repo)
awesome-dsh-plugin/

# Agent scratch / working directories
.workbuddy/
.dsh-vision-toolkit/
# Agent tool config. On this machine it is already covered by the GLOBAL git
# ignore (~/.config/git/ignore), but that is not portable — keep it here too.
.claude/
.agent/
.codex/

# Local debugging / scratch artifacts (one-off Playwright debug scripts, screenshots, chat test files)
debug-*.cjs
debug-*.png
quicksort.py

# Scratch dirs/files from local debugging sessions (CDP dumps, pasted bundles)
.debug/
.pideck-paste/
.client-*.tmp.ts

# Stray local pnpm store (should live outside the repo)
.pnpm-store/

# Local caches that must NOT land in the repo: scripts here pass `--cache .cache/npm`
# on machines with a tight C: drive (README/AGENTS 的 npm 缓存约定), and release
# verification downloads tarballs into .cache/ too. Not ignored until 2026-09-27,
# when one `git add -A` swept 19 npm-cache files + a published tarball into a commit.
.cache/

# Generated API docs (typedoc) — regenerate on demand with `pnpm docs:api`
docs/api/

# Preview intermediates (regenerated by scripts/screenshot-previews.cjs)
assets/previews/hero-mocha.png
